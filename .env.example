# ──────────────────────────────────────────────────────────────────────────────
# .env.local 생성을 위한 템플릿
#
# 복사 방법:
#   cp .env.example .env.local
# 이후 .env.local에 실제 값 작성
# ──────────────────────────────────────────────────────────────────────────────

# ─── GitHub OAuth App ─────────────────────────────────────────────────────────
# 발급: https://github.com/settings/developers → New OAuth App
# Homepage URL        : http://localhost:3000
# Callback URL        : http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Neon PostgreSQL ──────────────────────────────────────────────────────────
# 발급: https://console.neon.tech → 프로젝트 선택 → Connection string 복사
DATABASE_URL=

# ─── NextAuth.js ──────────────────────────────────────────────────────────────
# JWT 세션 서명에 사용하는 비밀 키. 누출 시 세션 위조가 가능하므로 안전하게 보관
# 생성 방법: openssl rand -base64 32
AUTH_SECRET=

# ─── SEO / canonical URL ──────────────────────────────────────────────────────
# sitemap, canonical, Open Graph URL 생성 기준 도메인
NEXT_PUBLIC_SITE_URL=https://openissuemap.com

# ─── OpenAI API ───────────────────────────────────────────────────────────────
# 이슈 상세 페이지 "AI 가이드" 분석에 사용. 미설정 시 해당 기능만 503으로 비활성화된다.
# 발급: https://platform.openai.com/api-keys (결제 수단 등록 + 크레딧 구매 필요)
OPENAI_API_KEY=

# ─── 추천 이슈 후보 풀 스케줄러 ──────────────────────────────────────────────────
# GitHub Actions 스케줄 워크플로가 /api/cron/refresh-recommendation-pool을 호출할 때
# Authorization: Bearer <값>으로 보내는 비밀값. 생성 방법: openssl rand -base64 32
# 미설정 시 이 엔드포인트는 모든 요청을 401로 거부한다(기능이 아니라 안전 기본값).
CRON_SECRET=
# 스케줄러 및 게스트 요청 폴백용 GitHub 토큰(OAuth App과 별개의 개인 액세스 토큰).
# 발급: https://github.com/settings/tokens → public_repo 권한
GITHUB_TOKEN=
